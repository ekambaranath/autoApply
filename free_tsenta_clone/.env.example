# Copy to .env and edit. Loaded automatically at startup.
# Nothing here is written to the database.

# ---------------------------------------------------------------- AI model
# Local and private (default). Needs: ollama pull llama3.1:8b
LLM_PROVIDER=ollama
OLLAMA_BASE_URL=http://localhost:11434
OLLAMA_MODEL=llama3.1:8b

# Hosted instead — any OpenAI-compatible endpoint. In Codespaces prefer this:
# Ollama needs several GB of RAM that a small Codespace does not have.
# LLM_PROVIDER=openai_compatible
# LLM_BASE_URL=https://openrouter.ai/api/v1
# LLM_API_KEY=sk-or-v1-...
# LLM_MODEL=nvidia/nemotron-3-super-120b-a12b:free

# Free tiers are served at low priority and a full tailored resume is several
# thousand tokens, so this is generous on purpose.
LLM_TIMEOUT=600

# ------------------------------------------------------------------- agent
# Minimum match score before the agent will consider auto-applying.
AUTO_APPLY_MIN_SCORE=80
# How often the background scanner runs both discovery paths.
SCAN_INTERVAL_MINUTES=30

# ------------------------------------------------------- inbox (optional)
# Reads employer replies and advances application statuses.
# Use an APP PASSWORD, not your account password — Gmail and Outlook
# both require one with 2FA enabled and reject a normal password.
# MAIL_IMAP_HOST=imap.gmail.com
# MAIL_IMAP_PORT=993
# MAIL_USER=you@example.com
# MAIL_PASSWORD=
# MAIL_FOLDER=INBOX
